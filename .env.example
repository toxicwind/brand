# brand environment knobs — copy to `.env` for local dev (`.env` is gitignored).
# Values shown are the defaults. Boolean-ish knobs accept 1/true/yes/on.

# --- Hyper-race focus (mcp/brand_focus_race.py) -----------------------------
# Skip the native plugin path (A); the race falls back to wlrctl + legacy.
BRAND_DISABLE_PLUGIN=0
# Dry run: log what the focus race would dispatch; change nothing.
BRAND_DRY_RUN=0
# Drive focus (and HyprManagement) against the mock compositor in
# tests/mock_compositor.py instead of a real compositor. Tests only.
BRAND_MOCK_COMPOSITOR=0
# JSON fixture for the mock compositor, e.g.:
# {"clients": [{"address": "0xaaa1", "pid": "4242", "class": "kitty",
#   "initialClass": "kitty", "processStartTime": "100001"}],
#  "active": "0xaaa1", "behavior": {"plugin": true}, "plugin_loaded": true}
# Behavior values: true = moves focus, false = bare "ok" without moving,
# "error" = dispatch fails.
#BRAND_MOCK_STATE=

# --- Security policy (mcp/security_policy.py) -------------------------------
#BRAND_READONLY=0
#BRAND_CONFINE=
#BRAND_APP_POLICIES=
#BRAND_PRIVACY_CLASSES=
#BRAND_CLIPBOARD=
#BRAND_SECURITY_AUDIT=1
